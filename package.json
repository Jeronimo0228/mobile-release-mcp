{
  "name": "mobile-release-mcp",
  "version": "0.2.0",
  "description": "MCP server for managing mobile app releases on App Store Connect and Google Play Console",
  "license": "MIT",
  "author": "Jerónimo Restrepo <jrestrepoa@eafit.edu.co>",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    ".env.example"
  ],
  "bin": {
    "mobile-release-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "google-play",
    "mobile",
    "release",
    "ios",
    "android",
    "testflight",
    "expo",
    "eas",
    "cursor",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeronimo0228/mobile-release-mcp.git"
  },
  "homepage": "https://github.com/Jeronimo0228/mobile-release-mcp#readme",
  "bugs": {
    "url": "https://github.com/Jeronimo0228/mobile-release-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@googleapis/androidpublisher": "^36.0.0",
    "googleapis-common": "^7.2.0",
    "hono": "^4.7.0",
    "@hono/node-server": "^1.13.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
